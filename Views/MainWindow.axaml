<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlgorithmAnalysis.ViewModels"
        xmlns:models="using:AlgorithmAnalysis.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="AlgorithmAnalysis.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Эмпирический анализ временной сложности алгоритмов"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="10" ColumnDefinitions="300,*" RowDefinitions="*">

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ: управление ===== -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,5,0">
            <ScrollViewer>
                <StackPanel Spacing="12">

                    <!-- Заголовок -->
                    <TextBlock Text="Выбор алгоритма" FontWeight="Bold" FontSize="16"/>

                    <!-- Список алгоритмов -->
                    <ListBox ItemsSource="{Binding Algorithms}"
                             SelectedItem="{Binding SelectedAlgorithm}"
                             MaxHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AbstractAlgorithm">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding TheoreticalComplexityLabel}"
                                               FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator/>

                    <!-- Размеры данных -->
                    <TextBlock Text="Размеры n:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SizesText}" 
                             PlaceholderText="100, 500, 1000, 2000..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="60"
                             FontSize="11"/>

                    <Separator/>

                    <!-- Кнопки -->
                    <Button Content="▶  Запустить анализ"
                            Command="{Binding RunBenchmarkCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,8"
                            FontWeight="Bold"
                            Background="#4CAF50" Foreground="White"/>

                    <Button Content="⏹  Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,8"/>

                    <!-- Прогресс -->
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"/>

                    <!-- Статус -->
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="#555"/>

                    <Separator/>

                    <!-- Экспорт -->
                    <Button Content="💾  Экспорт графика (PNG)"
                            Command="{Binding ExportChartCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,8"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== ПРАВАЯ ПАНЕЛЬ: график + таблица ===== -->
        <Grid Grid.Column="1" RowDefinitions="3*,2*" Margin="5,0,0,0">

            <!-- График (рендерится через ScottPlot в Bitmap) -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True" Margin="0,0,0,5"
                    Background="#FAFAFA">
                <Image x:Name="ChartImage"
                       Source="{Binding ChartImageSource}"
                       Stretch="Uniform"/>
            </Border>

            <!-- Таблица результатов -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,5,0,0">
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="n (размер)" Binding="{Binding N}" Width="100"/>
                        <DataGridTextColumn Header="T эксп. (мс)" Binding="{Binding AverageTimeMs, StringFormat='{}{0:F4}'}" Width="140"/>
                        <DataGridTextColumn Header="T теор. (мс)" Binding="{Binding TheoreticalTimeMs, StringFormat='{}{0:F4}'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

    </Grid>
</Window>
