<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlgorithmAnalysis.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="AlgorithmAnalysis.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Эмпирический анализ временной сложности алгоритмов"
        Width="1400" Height="800"
        WindowStartupLocation="CenterScreen">

	<Grid ColumnDefinitions="350,*,320" RowDefinitions="*">

		<!-- ══════════ ЛЕВАЯ ПАНЕЛЬ: список алгоритмов ══════════ -->
		<Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="10">
			<Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

				<TextBlock Grid.Row="0" Text="Выбор алгоритмов"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

				<!-- Список с чекбоксами -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<ListBox ItemsSource="{Binding Algorithms}"
                             SelectedItem="{Binding SelectedAlgorithm}"
                             SelectionMode="Single"
                             BorderThickness="0">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:SelectableAlgorithm">
								<Grid ColumnDefinitions="Auto,*" Margin="0,4">
									<CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
									<StackPanel Grid.Column="1">
										<TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
										<TextBlock Text="{Binding TheoreticalComplexityLabel}"
                                                   FontSize="11"
                                                   Foreground="#888888"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>

				<!-- Размеры n -->
				<StackPanel Grid.Row="2" Margin="0,8,0,0">
					<TextBlock Text="Размеры входных данных n:" FontWeight="SemiBold" Margin="0,0,0,4"/>
					<TextBox Text="{Binding SizesText}" />
					<Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
						<Button Grid.Column="0"
                                Content="Лаб. 1 (1..2000)"
                                Command="{Binding SetLabSizesCommand}"
                                Margin="0,0,2,0"/>
						<Button Grid.Column="1"
                                Content="Рекомендуемые"
                                Command="{Binding SetRecommendedSizesCommand}"
                                Margin="2,0,0,0"/>
					</Grid>
				</StackPanel>

				<!-- Кнопка "Запустить" -->
				<Button Grid.Row="3"
                        Content="▶  Запустить анализ"
                        Command="{Binding RunBenchmarkCommand}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#1976D2"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="10"/>

				<!-- Кнопка "Запустить все выбранные" -->
				<Button Grid.Row="4"
                        Content="▶▶  Запустить все выбранные"
                        Command="{Binding RunAllSelectedCommand}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#2E7D32"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        Padding="10"/>

				<!-- Чекбокс принудительного пересчёта -->
				<CheckBox Grid.Row="5"
                          Content="Принудительный пересчёт (игнорировать кэш)"
                          IsChecked="{Binding ForceRecalculate}"
                          Margin="0,8,0,0"
                          FontSize="12"/>

			</Grid>
		</Border>

		<!-- ══════════ ЦЕНТР: график ══════════ -->
		<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

			<!-- Заголовок / координаты -->
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="10,10,10,0">
				<TextBlock Grid.Column="0"
                           Text="{Binding HoverCoordinatesText}"
                           FontSize="12"
                           Foreground="#555555"
                           VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1"
                           Text="🔍 Колёсико: зум | Зажатие: панорама"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="2"
                        Content="↺ Сбросить масштаб"
                        Click="OnResetViewClick"
                        FontSize="12"/>
			</Grid>

			<!-- Интерактивный график -->
			<Border Grid.Row="1"
                    Name="ChartContainer"
                    Margin="10,8,10,10"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1">
				<Image Source="{Binding ChartImageSource}"
                       Stretch="Uniform"/>
			</Border>

			<!-- Статус + прогресс -->
			<StackPanel Grid.Row="2" Margin="10,0,10,10">
				<TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
				<TextBlock Text="{Binding CacheStatusText}"
                           FontSize="11"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
				<ProgressBar Value="{Binding Progress}"
                             Minimum="0" Maximum="100"
                             Height="6"/>
			</StackPanel>
		</Grid>

		<!-- ══════════ ПРАВАЯ ПАНЕЛЬ: результаты ══════════ -->
		<Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="10">
			<Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

				<TextBlock Grid.Row="0"
                           Text="Результаты"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,8"/>

				<DataGrid Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
					<DataGrid.Columns>
						<DataGridTextColumn Header="n" Binding="{Binding N}" Width="80"/>
						<DataGridTextColumn Header="T эксп (мс)" Binding="{Binding AverageTimeMs, StringFormat=F4}" Width="110"/>
						<DataGridTextColumn Header="T теор (мс)" Binding="{Binding TheoreticalTimeMs, StringFormat=F4}" Width="110"/>
					</DataGrid.Columns>
				</DataGrid>

				<!-- Сформировать отчёт -->
				<Button Grid.Row="2"
                        Content="📄  Сформировать полный отчёт"
                        Command="{Binding GenerateReportCommand}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#1976D2"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="10"/>

				<!-- Экспорт графика -->
				<Button Grid.Row="3"
                        Content="💾  Экспорт графика (PNG)"
                        Command="{Binding ExportChartCommand}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10"/>

				<!-- Отмена -->
				<Button Grid.Row="4"
                        Content="✖  Отмена"
                        Command="{Binding CancelCommand}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#C62828"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="10"/>

			</Grid>
		</Border>

	</Grid>
</Window>